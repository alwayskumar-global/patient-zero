# No variables or secrets are required for demo, tests, or public metadata ingestion.
# CLI .env files are not auto-loaded. Export overrides before starting.
# Next uses normal environment loading in web; no secrets/client variables are needed.
# PZ_CACHE_DIR=./data/cache
# Leave PZ_AS_OF unset for current-time gate/MCP/Explain; this sample is historical.
# PZ_AS_OF=2025-09-08T14:00:00.000Z
# GITHUB_TOKEN is reserved for future GitHub Advisory integration (not consumed).
# Never store npm credentials in this project.

# Optional web server paths; defaults work through root npm scripts.
# PZ_PROJECT_ROOT=/absolute/path/to/patient-zero
# PZ_WEB_STORE=patient-zero.rl
# Restart the web server after replacing its store.
# NEXT_TELEMETRY_DISABLED=1

# Optional verified Relate CLI executable for npm run test:relate-mcp only.
# PZ_RELATE_BIN=/absolute/path/to/relate
